import io
import json
from pathlib import Path

import numpy as np
import tensorflow as tf
from PIL import Image, UnidentifiedImageError
from fastapi import FastAPI, File, HTTPException, UploadFile

ROOT = Path(__file__).resolve().parent.parent

MODEL_PATH = (
    ROOT / "experiments/brand_recognition/models/"
    "brand_mobilenetv2_best.keras"
)

MAPPING_PATH = (
    ROOT / "experiments/brand_recognition/models/class_mapping.json"
)

IMAGE_SIZE = (224, 224)
MAX_FILE_SIZE = 5 * 1024 * 1024
CONFIDENCE_THRESHOLD = 0.60

app = FastAPI(
    title="JijiGreen Brand Recognition API",
    description="Experimental bottle brand recognition service.",
    version="1.0.0",
)

model = None
class_names = None


@app.on_event("startup")
def load_model():
    global model, class_names

    if not MODEL_PATH.exists():
        raise RuntimeError(f"Model not found: {MODEL_PATH}")

    if not MAPPING_PATH.exists():
        raise RuntimeError(f"Class mapping not found: {MAPPING_PATH}")

    with open(MAPPING_PATH, "r") as file:
        mapping = json.load(file)

    class_names = [
        name for name, index in
        sorted(mapping.items(), key=lambda item: item[1])
    ]

    model = tf.keras.models.load_model(
        MODEL_PATH,
        compile=False
    )

    print("JijiGreen brand model loaded successfully.")
    print("Classes:", class_names)


@app.get("/")
def home():
    return {
        "project": "JijiGreen",
        "service": "Brand Recognition API",
        "status": "running",
        "classes": class_names,
    }


@app.get("/health")
def health():
    return {
        "status": "healthy" if model is not None else "not_ready",
        "model_loaded": model is not None,
    }


@app.post("/predict/brand")
async def predict_brand(file: UploadFile = File(...)):

    allowed_types = {
        "image/jpeg",
        "image/png",
    }

    if file.content_type not in allowed_types:
        raise HTTPException(
            status_code=415,
            detail="Upload a JPG, JPEG or PNG image."
        )

    contents = await file.read(MAX_FILE_SIZE + 1)

    if len(contents) > MAX_FILE_SIZE:
        raise HTTPException(
            status_code=413,
            detail="Image exceeds the 5 MB limit."
        )

    if not contents:
        raise HTTPException(
            status_code=400,
            detail="Uploaded image is empty."
        )

    try:
        image = Image.open(io.BytesIO(contents))
        image.verify()

        image = Image.open(io.BytesIO(contents)).convert("RGB")
        image = image.resize(IMAGE_SIZE)

    except (UnidentifiedImageError, OSError, ValueError):
        raise HTTPException(
            status_code=400,
            detail="Invalid or corrupted image."
        )

    image_array = np.asarray(image, dtype=np.float32)
    image_array = np.expand_dims(image_array, axis=0)

    try:
        predictions = model.predict(image_array, verbose=0)[0]
    except Exception:
        raise HTTPException(
            status_code=500,
            detail="Model prediction failed."
        )

    predicted_index = int(np.argmax(predictions))
    confidence = float(predictions[predicted_index])

    probabilities = {
        class_names[i]: round(float(predictions[i]), 4)
        for i in range(len(class_names))
    }

    return {
        "success": True,
        "predicted_brand": class_names[predicted_index],
        "confidence": round(confidence, 4),
        "confidence_percent": round(confidence * 100, 2),
        "probabilities": probabilities,
        "manual_verification_recommended": (
            confidence < CONFIDENCE_THRESHOLD
        ),
        "model": "MobileNetV2",
        "experimental": True,
        "notice": (
            "Confidence is a model score, not a measure of "
            "real-world recognition accuracy."
        ),
    }
